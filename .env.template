# ==========================================
# GitHub 部署配置
# ==========================================
# 请填写以下信息，然后运行 setup.sh
# ==========================================

# 你的 GitHub 用户名
GITHUB_USER=

# GitHub Personal Access Token（需有 repo 权限）
# 创建方式: GitHub → Settings → Developer settings → Personal access tokens → Fine-grained tokens
# 权限: Contents (读写), Pages (读写)
GITHUB_TOKEN=

# Git 用户信息（建议用 GitHub 注册邮箱）
GIT_USER_NAME=
GIT_USER_EMAIL=
